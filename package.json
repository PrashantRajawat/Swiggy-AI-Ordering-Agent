{
  "name": "swiggy-ai-ordering-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI ordering agent for Swiggy (CLI + minimal web UI)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:web": "tsx src/web/server.ts",
    "start": "node dist/index.js",
    "start:web": "node dist/web/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "openai": "^4.77.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

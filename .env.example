# Optional: without a key, the app uses basic keyword intent parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Official Swiggy Food MCP endpoint (Streamable HTTP).
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
# If Swiggy rejects local dynamic registration, set a pre-approved public client ID here.
SWIGGY_MCP_CLIENT_ID=
# Must exactly match a redirect URI accepted by Swiggy.
SWIGGY_MCP_REDIRECT_URI=http://localhost:3000/api/mcp/auth/callback
# Optional for CLI; browser sign-in stores its token only in server memory.
SWIGGY_MCP_ACCESS_TOKEN=
SWIGGY_MCP_TIMEOUT_MS=15000
USE_MOCK_MCP=true
SWIGGY_MCP_MAX_RESTAURANTS=10
PORT=3000
SQLITE_DB_PATH=swiggy-agent.db
